NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Browser push notifications for "Ask the Market" thread replies.
# Generate a key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_CONTACT_EMAIL=admin@example.com

# Service role key (Project Settings -> API in Supabase) — server-only,
# used by /api/notify-reply to read push subscriptions (bypasses RLS).
# Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
